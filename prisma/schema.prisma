generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  APPLIED
  ASSESSMENT
  RECRUITER_SCREEN
  INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  POSITION_CLOSED
  NEEDS_REVIEW
}

enum EmailEventType {
  APPLICATION_CONFIRMATION
  ASSESSMENT
  RECRUITER_SCREEN
  INTERVIEW
  FINAL_INTERVIEW
  APPLICATION_UPDATE
  ADDITIONAL_INFORMATION_REQUEST
  REJECTION
  OFFER
  UNRELATED
  UNKNOWN
}

enum EmailDisposition {
  JOB_RELATED
  NEEDS_REVIEW
  IGNORED
}

enum EmailParserType {
  RULE_BASED
  AI
}

enum ReviewItemType {
  MISSING_RESUME
  MISSING_LOCATION
  AMBIGUOUS_APPLICATION_MATCH
  MISSING_COMPANY
  MISSING_POSITION
  POSSIBLE_DUPLICATE
}

enum ReviewItemStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model ResumeVersion {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model RawEmail {
  id                       String          @id @default(cuid())
  providerMessageId        String          @unique
  threadId                 String?
  sender                   String
  recipient                String
  subject                  String
  body                     String
  receivedAt               DateTime
  processed                Boolean         @default(false)
  classification           EmailEventType?
  classificationConfidence Float?          // BACKEND-ONLY: stripped by RawEmailDTO; only EmailParseDTO (dev tooling) exposes it
  // Parse metadata. All null until the email is parsed; disposition is set on every parse.
  disposition              EmailDisposition?
  parsedCompany            String?
  parsedPosition           String?
  parserType               EmailParserType?
  parserVersion            String?
  parseEvidence            Json?
  parseSecondarySignals    Json?
  createdAt                DateTime        @default(now())
  event                    ApplicationEvent?
  reviewItems              ReviewItem[]

  @@index([receivedAt])
  @@index([processed])
  @@index([disposition])
  @@index([threadId])
  @@index([sender])
}

model Application {
  id              String            @id @default(cuid())
  company         String
  position        String
  location        String?
  applicationDate DateTime
  currentStatus   ApplicationStatus @default(APPLIED)
  resumeVersionId String?
  resumeVersion   ResumeVersion?    @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  lastEventAt     DateTime?
  notes           String?
  needsUserReview Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  events          ApplicationEvent[]
  reviewItems     ReviewItem[]

  @@index([currentStatus])
  @@index([company])
  @@index([applicationDate])
  @@index([lastEventAt])
  @@index([needsUserReview])
  @@index([resumeVersionId])
}

model ApplicationEvent {
  id              String             @id @default(cuid())
  applicationId   String
  application     Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceEmailId   String?            @unique
  sourceEmail     RawEmail?          @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  eventType       EmailEventType
  eventDate       DateTime
  previousStatus  ApplicationStatus?
  newStatus       ApplicationStatus?
  summary         String?
  rejectionReason String?
  interviewRound  Int?
  createdAt       DateTime           @default(now())

  @@index([applicationId, eventDate])
  @@index([eventType])
}

model ReviewItem {
  id            String           @id @default(cuid())
  type          ReviewItemType
  status        ReviewItemStatus @default(OPEN)
  applicationId String?
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rawEmailId    String?
  rawEmail      RawEmail?        @relation(fields: [rawEmailId], references: [id], onDelete: SetNull)
  candidateIds  Json?
  message       String?
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?

  @@index([status])
  @@index([type])
  @@index([applicationId])
}
